{
  "manifest_version": 3,
  "name": "TabTailor",
  "version": "2.5",
  "description": "The Official Master Tailor for your tab management. Triage stale tabs with precision and branding.",
  "permissions": [
    "tabs",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "TabTailor Triage",
    "default_icon": "assets/icon-48.png"
  },
  "icons": {
    "16": "assets/icon-16.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "host_permissions": [
    "<all_urls>"
  ]
}
